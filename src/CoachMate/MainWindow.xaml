<Window
    x:Class="CoachMate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:board="using:CoachMate.Board"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="CoachMate">
    <Grid Background="#161512" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <muxc:MenuBar Background="Transparent">
            <muxc:MenuBarItem Title="File">
                <MenuFlyoutItem x:Name="FileNew" Text="New game">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="FileSave" Text="Save game…">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="FileExit" Text="Exit"/>
            </muxc:MenuBarItem>
            <muxc:MenuBarItem Title="Settings">
                <MenuFlyoutSubItem Text="Mode">
                    <ToggleMenuFlyoutItem x:Name="ModePlay" Text="Play" IsChecked="True"/>
                    <ToggleMenuFlyoutItem x:Name="ModePractice" Text="Practice"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Play as">
                    <ToggleMenuFlyoutItem x:Name="PlayWhite" Text="White" IsChecked="True"/>
                    <ToggleMenuFlyoutItem x:Name="PlayBlack" Text="Black"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="PiecesMenu" Text="Pieces"/>
                <MenuFlyoutSubItem Text="Opponent">
                    <ToggleMenuFlyoutItem x:Name="LvlMaster" Text="Master"/>
                    <ToggleMenuFlyoutItem x:Name="LvlClub" Text="Club ~1900"/>
                    <ToggleMenuFlyoutItem x:Name="LvlCasual" Text="Casual ~1400" IsChecked="True"/>
                    <ToggleMenuFlyoutItem x:Name="LvlBeginner" Text="Beginner ~900"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="PuzzleDbItem" Text="Get full puzzle DB (~700 MB)"/>
                <MenuFlyoutItem x:Name="AiSettingsItem" Text="AI settings…"/>
                <MenuFlyoutItem x:Name="RatingItem" Text="Your rating…"/>
            </muxc:MenuBarItem>
        </muxc:MenuBar>
        <Grid Grid.Row="1" Padding="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="22" Height="480" Background="#33302b"
                    CornerRadius="4" VerticalAlignment="Top">
                <Border x:Name="EvalFill" Height="240" Background="#f8f8f8" VerticalAlignment="Bottom"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                <board:ChessBoardView x:Name="Board">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="Top">
                            <StackPanel x:Name="PromoPanel" Orientation="Horizontal" Spacing="8"/>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </board:ChessBoardView>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                    <Button x:Name="BackBtn" Content="Back"/>
                    <Button x:Name="NewBtn" Content="New"/>
                    <Button x:Name="FlipBtn" Content="Flip"/>
                    <Button x:Name="HintBtn" Content="Hint"/>
                </StackPanel>
            </StackPanel>
            <Grid Grid.Column="2" Margin="20,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,16,0">
                    <TextBlock Text="CoachMate" FontSize="20" FontWeight="Bold" Foreground="#e8e6e3"/>
                    <Grid>
                        <TextBlock x:Name="Status" Text="Engine: starting..." Foreground="#9e9a93"/>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock x:Name="EvalText" Text="—" FontSize="18" FontWeight="SemiBold"
                                       Foreground="#e8e6e3" HorizontalAlignment="Right">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="Engine evaluation in pawns, from White's side: +0.3 means White is ahead about a third of a pawn. # means a forced mate was found."/>
                                </ToolTipService.ToolTip>
                            </TextBlock>
                            <TextBlock Text="+ white / − black, in pawns" FontSize="9" Foreground="#9e9a93"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="RatingText" Text="You: ~1500" Foreground="#81b64c" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Phase:" Foreground="#9e9a93" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PhaseText" Text="Opening" FontWeight="Bold" Foreground="#e8e6e3"/>
                    </StackPanel>
                    <TextBlock x:Name="GoalText" TextWrapping="Wrap" FontSize="12" Foreground="#9e9a93"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10">
                <Border Background="#262421" CornerRadius="8" Padding="10" Width="340">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Cloud DB" FontWeight="Bold" Foreground="#e8e6e3"/>
                        <ItemsControl x:Name="BookList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding San}" FontWeight="Bold" Foreground="#e8e6e3"/>
                                        <Grid Grid.Column="1" Height="8" Background="#333" CornerRadius="3" VerticalAlignment="Center">
                                            <Border Width="{Binding BarWidth}" Background="#81b64c" CornerRadius="3" HorizontalAlignment="Left"/>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding Winrate}" Foreground="#9e9a93" FontSize="12" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="BookStatus" Text="—" Foreground="#9e9a93" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Background="#262421" CornerRadius="8" Padding="10" Width="340">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Ask the coach" FontWeight="Bold" Foreground="#e8e6e3"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox x:Name="AskBox" PlaceholderText="e.g. why is my knight bad here?" Width="260" FontSize="12"/>
                            <Button x:Name="AskBtn" Content="Ask"/>
                        </StackPanel>
                        <TextBlock x:Name="AskOut" Text="Answers appear here — grounded in the current position and engine analysis."
                                   Foreground="#e8e6e3" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </StackPanel>
                </Border>
                <Border Background="#262421" CornerRadius="8" Padding="10" Width="340">
                    <ScrollViewer MaxHeight="200">
                        <ItemsControl x:Name="CoachFeed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#e8e6e3"/>
                                            <TextBlock Text="{Binding Symbol}" FontWeight="Bold" Margin="6,0,0,0"
                                                       Foreground="{Binding SymbolBrush}"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Why}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding}" Foreground="#e8e6e3" TextWrapping="Wrap"/></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Refutation}" Foreground="#9e9a93" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Line}" Foreground="#9e9a93" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
